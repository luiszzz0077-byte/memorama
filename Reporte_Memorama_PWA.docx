      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>
        <w:t>• style.css — Estilos, diseño responsivo y animaciones</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="31" w14:textId="31" w:rsidR="0089282E" w:rsidRDefault="0089282E">

          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
        </w:rPr>
        <w:t>Actividad No. 4</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="11" w14:textId="11" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
        </w:rPr>
        <w:t>Nombre de la práctica: </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>
        <w:t>Juego de Memorama (PWA)</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="12" w14:textId="12" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
    </w:p>
    <w:p w14:paraId="13" w14:textId="13" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
          <w:sz w:val="28"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
          <w:sz w:val="28"/>
        </w:rPr>
        <w:t>I. Objetivo de la práctica</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="14" w14:textId="14" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>
        <w:t>Diseñar la interfaz de usuario (UI) y experiencia de usuario (UX) de una aplicación móvil del Juego de Memorama, aplicando los principios fundamentales del diseño centrado en el usuario, la psicología del color y la usabilidad, para crear una experiencia digital atractiva, intuitiva y efectiva para el usuario final, con apoyo de diversas herramientas de desarrollo.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="15" w14:textId="15" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
    </w:p>
    <w:p w14:paraId="16" w14:textId="16" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
          <w:sz w:val="28"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
          <w:sz w:val="28"/>
        </w:rPr>
        <w:t>II. Justificación de la práctica</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="17" w14:textId="17" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>
        <w:t>El estudiante se verá inmerso en el diseño de un micromundo para introducir de manera práctica e integral los procesos y principios esenciales del diseño de aplicaciones móviles, aplicando las habilidades técnicas y de pensamiento crítico altamente valoradas en el panorama digital actual. También es importante resaltar que el alumno tendrá un aprendizaje práctico, debido a los conceptos teóricos de diseño (UI/UX, teoría del color, composición) a un proyecto tangible y completo. También desarrollará competencias como: la resolución de problemas, la creatividad y el pensamiento lógico al definir el flujo de la aplicación.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="18" w14:textId="18" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
    </w:p>
    <w:p w14:paraId="19" w14:textId="19" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
          <w:sz w:val="28"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
          <w:b/>
          <w:sz w:val="28"/>
        </w:rPr>
        <w:t>III. Material y/o equipo necesario</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="20" w14:textId="20" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>
        <w:t>• Computadora o laptop</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="21" w14:textId="21" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>

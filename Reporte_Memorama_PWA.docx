    <w:p w14:paraId="23" w14:textId="23" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>

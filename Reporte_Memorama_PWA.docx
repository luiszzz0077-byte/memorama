    <w:p w14:paraId="22" w14:textId="22" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
      <w:r>

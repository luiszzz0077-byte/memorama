      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>
        <w:t>• app.js — Lógica del juego, manejo de estado, temporizador</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="32" w14:textId="32" w:rsidR="0089282E" w:rsidRDefault="0089282E">

        </w:rPr>
        <w:t>• Navegador web: Google Chrome (para DevTools y prueba PWA)</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="25" w14:textId="25" w:rsidR="0089282E" w:rsidRDefault="0089282E">
      <w:pPr>
        <w:spacing w:line="360" w:lineRule="auto"/>
      </w:pPr>
      <w:r>

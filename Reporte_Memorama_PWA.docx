        <w:rPr>
          <w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica"/>
        </w:rPr>
        <w:t>• manifest.json — Configuración PWA (nombre, iconos, display, etc.)</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="33" w14:textId="33" w:rsidR="0089282E" w:rsidRDefault="0089282E">
